diff --git a/src/gallium/drivers/llvmpipe/lp_setup.c b/src/gallium/drivers/llvmpipe/lp_setup.c
index 527d372..0f321f2 100644
--- a/src/gallium/drivers/llvmpipe/lp_setup.c
+++ b/src/gallium/drivers/llvmpipe/lp_setup.c
@@ -52,6 +52,7 @@
 #include "lp_query.h"
 #include "lp_rast.h"
 #include "lp_setup_context.h"
+#include "lp_tensix.h"
 #include "lp_screen.h"
 #include "lp_state.h"
 #include "lp_jit.h"
@@ -412,6 +413,7 @@ void
 lp_setup_flush(struct lp_setup_context *setup,
                const char *reason)
 {
+   lp_tensix_flush(setup->tensix);
    set_scene_state(setup, SETUP_FLUSHED, reason);
 }
 
@@ -422,6 +424,9 @@ lp_setup_bind_framebuffer(struct lp_setup_context *setup,
 {
    LP_DBG(DEBUG_SETUP, "%s\n", __func__);
 
+   /* Render a frame the Tensix offload holds into the old framebuffer first (unless the new one is the same). */
+   lp_tensix_bind_framebuffer(setup->tensix, fb);
+
    /* Flush any old scene.
     */
    set_scene_state(setup, SETUP_FLUSHED, __func__);
@@ -586,6 +591,11 @@ lp_setup_clear(struct lp_setup_context *setup,
                unsigned stencil,
                unsigned flags)
 {
+   /* A full colour+depth clear opens a frame of the Tensix offload; the rest (if any) is llvmpipe's. */
+   flags = lp_tensix_clear(setup->tensix, color, depth, stencil, flags);
+   if (!flags)
+      return;
+
    /*
     * Note any of these (max 9) clears could fail (but at most there should
     * be just one failure!). This avoids doing the previous succeeded
@@ -864,6 +874,10 @@ lp_setup_linear_rasterizer_supported(void)
     * is more than ten-year-old technology, so it's a reasonable
     * baseline.
     */
+   /* The Tensix offload takes triangles after clipping and set-up; the linear rasterizer's rectangles and its unclipped vertices
+    * would bypass it. */
+   if (lp_tensix_enabled())
+      return false;
 #if DETECT_ARCH_SSE
    return util_get_cpu_caps()->has_sse2;
 #else
@@ -1024,6 +1038,10 @@ lp_setup_is_resource_referenced(const struct lp_setup_context *setup,
       return LP_REFERENCED_FOR_READ | LP_REFERENCED_FOR_WRITE;
    }
 
+   /* the frame the Tensix offload holds will write its render targets */
+   if (lp_tensix_references(setup->tensix, texture))
+      return LP_REFERENCED_FOR_READ | LP_REFERENCED_FOR_WRITE;
+
    /* check resources referenced by active scenes */
    for (unsigned i = 0; i < setup->num_active_scenes; i++) {
       struct lp_scene *scene = setup->scenes[i];
@@ -1295,6 +1313,9 @@ lp_setup_update_state(struct lp_setup_context *setup,
 
       assert(lp->dirty == 0);
 
+      /* The state of the next draw is up to date: the Tensix offload decides where its triangles go. */
+      lp_tensix_update(setup->tensix);
+
       assert(lp->cached_setup_key.size ==
              setup->setup.variant->key.size);
 
@@ -1344,6 +1365,10 @@ lp_setup_update_state(struct lp_setup_context *setup,
 void
 lp_setup_destroy(struct lp_setup_context *setup)
 {
+   lp_tensix_flush(setup->tensix);
+   lp_tensix_destroy(setup->tensix);
+   setup->tensix = NULL;
+
    lp_setup_reset(setup);
 
    util_unreference_framebuffer_state(&setup->fb);
@@ -1439,6 +1464,8 @@ lp_setup_create(struct pipe_context *pipe,
    setup->framebuffer.x1 = -1;
    setup->framebuffer.y1 = -1;
 
+   setup->tensix = lp_tensix_create(setup);
+
    return setup;
 
